[Unit]
Description=Jarvis OS Vision (riconoscimento facciale locale)
After=jarvis-supervisor.service
PartOf=jarvis-supervisor.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/Jarvis/installer_wizard/venv/bin/python /opt/Jarvis/installer_wizard/features/vision/service.py
Restart=always
RestartSec=5
Nice=5
MemoryMax=1G
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
